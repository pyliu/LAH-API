# ═══════════════════════════════════════════════════════════════════════════
#  LAH-API 環境變數設定範本 (.env.example)
#  請複製此檔並命名為 .env，放置於 www/ 根目錄下 (www/.env)
#  注意：MSSQL 相關連線參數 (MS_DB_*, MS_DOC_DB_*, MS_TDOC_DB_*) 仍保留於 SQLite dimension.db 維護
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# 【區塊 1】系統運行模式與開關
# ───────────────────────────────────────────────────────────────────────────
# MOCK 模式開關（可設 true / false 或 1 / 0，優先覆蓋 dimension.db 中的設定）
MOCK=false

# 工作天檢查開關 (true / false)
ENABLE_OFFICE_HOURS=true

# 大頭照功能開關 (true / false)
ENABLE_AVATAR=true

# MOCK 快取有效秒數 (預設 86400 秒 / 1 天)
MOCK_CACHE_SECONDS=86400

# ───────────────────────────────────────────────────────────────────────────
# 【區塊 2】事務所站台與地政 WEB AP 設定
# ───────────────────────────────────────────────────────────────────────────
# 事務所代碼 (例如 HA:桃園, HB:中壢, HC:大溪, HD:楊梅, HE:蘆竹, HF:八德, HG:平鎮, HH:龜山)
SITE=HA

# 事務所站台 ID (通常對應課室或代碼)
SITE_ID=HA

# 地政 WEB AP 伺服器主機 IP
WEBAP_IP=220.1.34.161

# Web AP IP 後綴清單 (逗號分隔，用於連線狀態監控比對)
WEBAP_POSTFIXES=205,206,207,62,156,118,161,60

# Web AP JNDI 連線數監控上限門檻 (LOCAL)
WEBAP_JNDI_LOCAL=3000

# Web AP JNDI 連線數監控上限門檻 (XALOCAL)
WEBAP_JNDI_XALOCAL=1250

# ───────────────────────────────────────────────────────────────────────────
# 【區塊 3】Oracle 地政資料庫連線設定 (主要 / 備份 / 測試 / 同步)
# ───────────────────────────────────────────────────────────────────────────
# 目前使用的目標資料庫 (可設為: HXWEB:主要, BACKUP:備份, HXT:測試)
ORA_DB_TARGET=HXWEB

# Oracle 資料庫存取帳號
ORA_DB_USER=KAPUSER

# Oracle 資料庫存取密碼
ORA_DB_PASS=KAPPASSWD

# 主要地政資料庫 (HXWEB) 連線主機與 Port
ORA_DB_HXWEB_IP=220.1.3X.XXX
ORA_DB_HXWEB_PORT=1521

# 備份地政資料庫 (BACKUP) 連線主機與 Port
ORA_DB_BACKUP_IP=220.1.3X.XXX
ORA_DB_BACKUP_PORT=1521

# 測試地政資料庫 (HXT) 連線主機與 Port
ORA_DB_HXT_IP=192.168.1X.XXX
ORA_DB_HXT_PORT=1521

# 同步異動資料庫 L1HWEB (本所) 連線主機與 Port
ORA_DB_L1HWEB_IP=220.1.3X.XXX
ORA_DB_L1HWEB_PORT=1521

# 同步異動資料庫 L2HWEB (外所) 連線主機與 Port
ORA_DB_L2HWEB_IP=220.1.3X.XXX
ORA_DB_L2HWEB_PORT=1521

# 同步異動資料庫 L3HWEB (全區) 連線主機與 Port
ORA_DB_L3HWEB_IP=220.1.3X.XXX
ORA_DB_L3HWEB_PORT=1521

# 資料庫 Ping 連線心跳檢查間隔秒數
PING_INTERVAL_SECONDS=60

# ───────────────────────────────────────────────────────────────────────────
# 【區塊 4】本機伺服器與推播服務設定
# ───────────────────────────────────────────────────────────────────────────
# API 伺服器主機 IP 與 Port
API_SERVER_IP=127.0.0.1
API_SERVER_PORT=80

# WebSocket 即時通訊伺服器 (LAH-WSS) 主機 IP 與 Port
WS_SERVER_IP=127.0.0.1
WS_SERVER_PORT=8082

# WebSocket 伺服器訊息資料庫分庫路徑 (指向 lah-messenger-server/db)
WS_DB_PATH=c:\AppServ\lah-messenger-server\db

# ───────────────────────────────────────────────────────────────────────────
# 【區塊 5】監控郵件與印表機設定
# ───────────────────────────────────────────────────────────────────────────
# 監控郵件接收協議 (可設: imap 或 pop3)
MONITOR_MAIL_METHOD=imap

# 郵件伺服器主機位址
MONITOR_MAIL_HOST=mail57.ha.cenweb.land.moi

# 監控收件帳號
MONITOR_MAIL_ACCOUNT=hamonitor@mail57.ha.cenweb.land.moi

# 監控收件密碼
MONITOR_MAIL_PASSWORD=XXXXXXXX

# 郵件伺服器是否啟用 SSL 連線 (true / false)
MONITOR_MAIL_SSL=true

# 監控印表機清單設定 (JSON 陣列字串)
MONITOR_PRINTERS=[]

# ───────────────────────────────────────────────────────────────────────────
# 【區塊 6】系統管理金鑰與儲存路徑
# ───────────────────────────────────────────────────────────────────────────
# 前後端通訊 API 金鑰
API_KEY=your-api-key-here

# 管理者登入密碼 MD5 雜湊值 (預設 034917647 雜湊為 1f7744350d3dd3dc563421582f37f99e)
MASTER_PASSWORD=1f7744350d3dd3dc563421582f37f99e

# 使用者大頭照存放目錄絕對路徑
USER_PHOTO_FOLDER=c:\AppServ\www\assets\img\users
