# ═══════════════════════════════════════════════════════════════════════════
#  LAH-API 環境變數設定範本 (.env.example)
#  請複製此檔並命名為 .env，放置於 www/ 根目錄下 (www/.env)
# ═══════════════════════════════════════════════════════════════════════════

# MOCK 模式開關（支援 MOCK 或 ENABLE_MOCK_MODE，優先取 MOCK）
# 可設定為: true, false, 1, 0
# 若此處有設定，將優先覆蓋 dimension.db 中的設定；若未設定則回退讀取 dimension.db
MOCK=true
