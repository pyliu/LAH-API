# ═══════════════════════════════════════════════════════════════════════════
#  ASUSTOR NAS 系統與影音中心 - 環境設定範本 (.env.example)
#  請複製此檔並命名為 .env，並修改自訂 PIN 碼
# ═══════════════════════════════════════════════════════════════════════════

# 系統安全認證 PIN 碼 (請自訂為您專屬的 PIN 碼)
PIN=1234

# 登入憑證有效期間 (天數，預設 7 天)
AUTH_EXPIRES_DAYS=7

# 允許嘗試失敗最大次數 (防止暴力破解)
AUTH_MAX_ATTEMPTS=5

# 影音中心媒體庫掃描路徑清單 (支援多個路徑，可用半形逗號 , 分號 ; 或直線 | 分隔)
# 預設為：\\220.1.34.50\syslog\Recording
# APACHE注意事項: Apache24 服務目前的登入身分就是「本機系統帳戶 (Local System)」，若無法存取網路路徑請打開服務內容視窗到「登入」分頁，點選下方的「這個帳戶(T)」用可以使用該路徑帳號做登入
VIDEO_DIRS=\\220.1.34.50\syslog\Recording
