# ═══════════════════════════════════════════════════════════════════════════
#  ASUSTOR NAS 系統與影音中心 - 環境設定範本 (.env.example)
#  請複製此檔並命名為 .env，並修改自訂 PIN 碼
# ═══════════════════════════════════════════════════════════════════════════

# 系統安全認證 PIN 碼 (請自訂為您專屬的 PIN 碼)
PIN=1234

# 登入憑證有效期間 (天數，預設 7 天)
AUTH_EXPIRES_DAYS=7

# 允許嘗試失敗最大次數 (防止暴力破解)
AUTH_MAX_ATTEMPTS=5

# 影音中心媒體庫掃描路徑清單 (支援多個路徑，可用半形逗號 , 分號 ; 或直線 | 分隔)
# 預設為：/share/USB1/@暫存,/share/USB1/@影片
VIDEO_DIRS="/share/USB1/@暫存,/share/USB1/@影片"
